# Server
PORT=8787
NODE_ENV=production

# First boot only: creates the sole user + loads seed into SQLite.
# Use a strong password (min 8 chars). Never commit this file.
ANCLA_USERNAME=changeme
ANCLA_PASSWORD=change-me-to-a-strong-password

# Optional absolute path for SQLite (default: ./data/ancla.db)
# ANCLA_DB_PATH=/var/lib/ancla/ancla.db
